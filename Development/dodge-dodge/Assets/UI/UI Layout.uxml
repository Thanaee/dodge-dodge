<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <!-- ScoreLabel -->
    <ui:Label text="Score: 0" name="ScoreLabel" style="position: absolute; top: 86px; font-size: 70px; color: rgb(245, 235, 13); left: 800px; width: 267px; right: 43px; -unity-font-definition: url(&quot;project://database/Assets/fonts/Share_Tech_Mono/ShareTechMono-Regular.ttf?fileID=12800000&amp;guid=ca409c1f5c66f4bb58a4e51b1fbbdb0b&amp;type=3#ShareTechMono-Regular&quot;); -unity-text-align: upper-center; pointer-events: none;" />

    <!-- Oben rechts: Pause- und Menu-Buttons -->
    <ui:Button text="II" name="HudPauseButton" style="position: absolute; top: 25px; right: 125px; width: 50px; height: 50px; font-size: 22px; color: rgb(210, 240, 255); background-color: rgba(15, 25, 45, 0.85); border-color: rgb(140, 205, 255); border-width: 2px; border-radius: 14px; -unity-font-definition: url(&quot;project://database/Assets/fonts/Exo_2/static/Exo2-Bold.ttf&quot;);" />
    <ui:Button text="MENU" name="HudMenuButton" style="position: absolute; top: 25px; right: 25px; height: 50px; padding-left: 18px; padding-right: 18px; font-size: 18px; color: rgb(210, 240, 255); background-color: rgba(15, 25, 45, 0.85); border-color: rgb(140, 205, 255); border-width: 2px; border-radius: 14px; -unity-font-definition: url(&quot;project://database/Assets/fonts/Exo_2/static/Exo2-Bold.ttf&quot;);" />

    <!-- Highscore & Restart Button -->
    <ui:Label text="Highscore: 0" name="HighscoreLabel" style="position: absolute; top: 170px; font-size: 50px; color: rgb(245, 235, 13); left: 750px; width: 380px; -unity-font-definition: url(&quot;project://database/Assets/fonts/Share_Tech_Mono/ShareTechMono-Regular.ttf?fileID=12800000&amp;guid=ca409c1f5c66f4bb58a4e51b1fbbdb0b&amp;type=3#ShareTechMono-Regular&quot;); -unity-text-align: middle-center; display: none;" />
    <ui:Button text="RESTART" name="RestartButton" style="position: absolute; top: 570px; left: 825px; width: 230px; height: 60px; font-size: 28px; color: rgb(210, 240, 255); background-color: rgba(15, 25, 45, 0.9); border-color: rgb(140, 205, 255); border-width: 2px; border-radius: 30px; -unity-font-definition: url(&quot;project://database/Assets/fonts/Exo_2/static/Exo2-Bold.ttf&quot;); display: none;" />

    <!-- Pause-Overlay -->
    <ui:VisualElement name="PauseOverlay" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(6, 10, 20, 0.78); justify-content: center; align-items: center; display: none;">
        <ui:Label text="PAUSE" style="font-size: 60px; color: rgb(210, 240, 255); margin-bottom: 25px; -unity-font-definition: url(&quot;project://database/Assets/fonts/Exo_2/static/Exo2-Bold.ttf&quot;);" />
        <ui:Button text="CONTINUE" name="ResumeButton" style="width: 250px; height: 55px; font-size: 22px; color: rgb(210, 240, 255); background-color: rgba(15, 25, 45, 0.9); border-color: rgb(140, 205, 255); border-width: 2px; margin-bottom: 15px; border-radius: 30px; -unity-font-definition: url(&quot;project://database/Assets/fonts/Exo_2/static/Exo2-Bold.ttf&quot;);" />
        <ui:Button text="MENU" name="PauseMenuButton" style="width: 250px; height: 55px; font-size: 22px; color: rgb(210, 240, 255); background-color: rgba(15, 25, 45, 0.9); border-color: rgb(140, 205, 255); border-width: 2px; border-radius: 30px; -unity-font-definition: url(&quot;project://database/Assets/fonts/Exo_2/static/Exo2-Bold.ttf&quot;);" />
    </ui:VisualElement>
</ui:UXML>
